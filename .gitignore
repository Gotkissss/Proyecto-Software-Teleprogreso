# Entorno
.env
*.env
.env.*
!.env.example

# Credenciales, llaves y volcados de la base. Un dump commiteado por error es
# la forma más común de que se filtre una base entera: no depende de que nadie
# ataque nada, basta con que el repositorio se haga público.
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
*.sql.gz
*.dump
*.bak
backups/

# Python 
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node / React 
node_modules/
dist/
frontend/dist/

# IDE 
.vscode/
.idea/

# Archivos subidos en tiempo de ejecución (imágenes de activos y
# fotos de evidencia). Se sirven desde /static pero no se versionan.
backend/static/

# OS
.DS_Store
Thumbs.db

# Agents
AGENTS.md
RESUMEN_PROYECTO.md
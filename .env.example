# =============================================================
# Variables de entorno
# =============================================================
# Este archivo se debe copiar como .env y completar con las credenciales.
# El .env NUNCA se sube al repositorio (está en .gitignore).
#
# Genera cada secreto con un comando, no lo inventes a mano:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# =============================================================
# PostgreSQL — superusuario
# =============================================================
# Solo lo usan el arranque de la base y quien administre a mano. El backend NO
# se conecta con este usuario si defines APP_DB_USER más abajo.
# La contraseña debe ser larga y aleatoria: es lo único que separa a alguien
# de todos los datos si llegara a alcanzar el puerto del motor.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Rol de aplicación con privilegios mínimos (recomendado) ---
# Si rellenas estas dos variables, el backend se conecta con un rol que NO es
# superusuario: no puede crear roles, ni leer otras bases, ni ejecutar
# comandos del sistema operativo desde SQL. Si alguna vez se filtra la cadena
# de conexión del backend, el alcance del daño queda acotado a esta base.
#
# Se crea automáticamente si el volumen de Postgres es nuevo. Si tu base ya
# tiene datos, aplícalo una vez a mano con:
#   backend/db/aplicar_rol_aplicacion.sql   (instrucciones dentro del archivo)
#
# Déjalas vacías si prefieres no tocar nada todavía: en ese caso el backend
# sigue conectándose con POSTGRES_USER, exactamente como antes.
APP_DB_USER=
APP_DB_PASSWORD=

# =============================================================
# Backend (FastAPI)
# =============================================================
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Entorno: development | production | test
# En production la app exige https en los orígenes de CORS, exige ALLOWED_HOSTS
# y deja de publicar /docs y /openapi.json.
ENVIRONMENT=development

# Llave con la que se firman los JWT. Es la credencial más sensible del
# proyecto: con ella se puede fabricar un token de administrador y leer toda la
# base sin tocar Postgres. Mínimo 32 caracteres aleatorios; el backend se niega
# a arrancar con una llave corta o de ejemplo.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes exactos del frontend. No se admite "*".
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Dominios desde los que se sirve la API. Vacío = sin restricción (desarrollo).
# Obligatorio cuando ENVIRONMENT=production, p.ej.:
#   ALLOWED_HOSTS=["api.teleprogreso.com"]
ALLOWED_HOSTS=

# --- Defensa del login contra fuerza bruta ---
# Tras LOGIN_MAX_INTENTOS fallos desde la misma IP contra el mismo correo
# dentro de LOGIN_VENTANA_SEGUNDOS, esa combinación queda bloqueada
# LOGIN_BLOQUEO_SEGUNDOS.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEGUNDOS=300
LOGIN_BLOQUEO_SEGUNDOS=900

# Tope general de peticiones por minuto y por IP para el resto de la API.
RATE_LIMIT_POR_MINUTO=240

# Tamaño máximo de cualquier cuerpo de petición, en MB.
MAX_REQUEST_BODY_MB=10

# --- Límites de la conexión a Postgres ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_TX_TIMEOUT_MS=60000

# Zona horaria de la operación y hora a partir de la cual un técnico sin
# entrada marcada genera alerta.
TIMEZONE=America/Guatemala
ALERTA_HORA_LIMITE=08:00

# ⚠️ DESTRUCTIVO. En true, seed.py vacía TODAS las tablas de datos al arrancar
# y vuelve a sembrar el escenario de demostración. Sirve para repoblar un
# entorno desplegado (Railway) donde no se puede tirar el volumen.
# Ponerlo en true, desplegar una vez, y volver a false: si se queda activo,
# cada reinicio del contenedor borra la base.
SEED_RESET=false

# =============================================================
# Publicación de puertos
# =============================================================
# Interfaz del host donde se publican backend (8000) y frontend (5173).
# 127.0.0.1 = solo esta computadora; nadie más en la red puede llegar.
# Cámbialo a 0.0.0.0 únicamente si necesitas entrar desde otro dispositivo
# (por ejemplo probar desde el celular) y sabiendo que entonces cualquiera en
# esa red alcanza la API.
#
# La base de datos NO se publica en ningún caso. Para abrirla temporalmente en
# 127.0.0.1:5433 y conectar DBeaver/pgAdmin:
#   docker compose -f docker-compose.yml -f docker-compose.admin.yml up -d
BIND_HOST=127.0.0.1

# =============================================================
# Frontend (React)
# =============================================================
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=Teleprogreso S.A.

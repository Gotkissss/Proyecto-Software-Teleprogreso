# =============================================
# Variables de entorno
# =============================================
# Este archivo de debe copiar como .env y completar con las credenciales

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Zona horaria de la operación y hora a partir de la cual un técnico sin
# entrada marcada genera alerta.
TIMEZONE=America/Guatemala
ALERTA_HORA_LIMITE=08:00

# ⚠️ DESTRUCTIVO. En true, seed.py vacía TODAS las tablas de datos al arrancar
# y vuelve a sembrar el escenario de demostración. Sirve para repoblar un
# entorno desplegado (Railway) donde no se puede tirar el volumen.
# Ponerlo en true, desplegar una vez, y volver a false: si se queda activo,
# cada reinicio del contenedor borra la base.
SEED_RESET=false

# --- Frontend (React) ---
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=Teleprogreso S.A.
